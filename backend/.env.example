# Comma-separated exact frontend origins allowed by CORS (no trailing slash).
# Unset = localhost only (dev). MUST be set in production.
ALLOW_ORIGINS=https://your-frontend.vercel.app
# Optional: path to a fine-tuned transformer model folder
# TRANSFORMER_MODEL=/app/models/transformer
# Optional: uvicorn worker count (Docker)
# WEB_CONCURRENCY=2
